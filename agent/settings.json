{
  "defaultProvider": "openai",
  "defaultModel": "gpt-6-luna",
  "enabledModels": [
    "openai/gpt-6-astra",
    "openai/gpt-6-luna",
    "openai/gpt-6.1-sol"
  ],
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-questions"
  ],
  "theme": "minimal-dark",
  "quietStartup": "header",
  "hideThinkingBlock": true,
  "terminal": {
    "trueColor": true
  }
}
